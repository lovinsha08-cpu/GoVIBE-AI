PORT=4000
NODE_ENV=development

# From your Supabase project settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# From Google AI Studio — used for itinerary/budget AI features, and as the
# FALLBACK LLM provider for the AI chatbot (see llmProvider.service.js),
# used only when Groq is unavailable or GROQ_API_KEY is unset.
GEMINI_API_KEY=
# Optional — defaults to gemini-3.5-flash if unset (see ai.service.js). Set
# this to point at a different Gemini model without touching code.
GEMINI_MODEL=gemini-3.5-flash

# From console.groq.com — used by llmProvider.service.js as the PRIMARY LLM
# provider for the AI chatbot's tool-calling/conversation loop (Gemini above
# is only used as its fallback). Also used by other existing agents/services
# that call Groq directly where applicable (e.g. itineraryAgent.service.js's
# AI Agent tool-calling loop, and groqAdapter.service.js's Gemini-shaped
# translation layer that llmProvider.service.js calls into).
GROQ_API_KEY=
# Specifies the Groq model used for the chatbot (and by other Groq-calling
# services above). No default is applied in code — set this to a Groq model
# that supports tool/function calling (e.g. openai/gpt-oss-120b).
GROQ_MODEL=

# Frontend origin allowed to call this API
CORS_ORIGIN=http://localhost:5173

# From your Amadeus for Developers "Self-Service" app (test.api.amadeus.com)
# https://developers.amadeus.com/my-apps
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
# Switch to https://api.amadeus.com once you move to a production Amadeus app
AMADEUS_BASE_URL=https://test.api.amadeus.com

# Maps: no key needed. The app uses Leaflet + free OpenStreetMap tiles, and
# the seed script (scripts/seedSpots.js) uses free Nominatim + Overpass APIs.
# If SUPABASE_URL/SUPABASE_ANON_KEY are left blank, the /api/spots endpoint
# and itinerary engine automatically fall back to the bundled sample dataset
# (backend/src/data/sampleSpots.json) so the app still runs with zero setup.