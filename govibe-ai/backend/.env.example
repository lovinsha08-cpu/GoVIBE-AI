PORT=4000
NODE_ENV=development

# From your Supabase project settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# From Google AI Studio — used for itinerary/budget AI features
GEMINI_API_KEY=
# Optional — defaults to gemini-3.5-flash if unset (see ai.service.js). Set
# this to point at a different Gemini model without touching code.
GEMINI_MODEL=gemini-3.5-flash

# Frontend origin allowed to call this API
CORS_ORIGIN=http://localhost:5173

# From your Amadeus for Developers "Self-Service" app (test.api.amadeus.com)
# https://developers.amadeus.com/my-apps
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
# Switch to https://api.amadeus.com once you move to a production Amadeus app
AMADEUS_BASE_URL=https://test.api.amadeus.com

# Maps: no key needed. The app uses Leaflet + free OpenStreetMap tiles, and
# the seed script (scripts/seedSpots.js) uses free Nominatim + Overpass APIs.
# If SUPABASE_URL/SUPABASE_ANON_KEY are left blank, the /api/spots endpoint
# and itinerary engine automatically fall back to the bundled sample dataset
# (backend/src/data/sampleSpots.json) so the app still runs with zero setup.

# Google Places API key — used for: (1) the legacy spot-seeding/Emergency
# Services lookups in googlePlaces.service.js, and (2) the Places API (New)
# familiarity/quality enrichment in googlePlacesEnrichment.service.js used
# during itinerary generation. Optional — itinerary generation works
# without it (candidates just keep their existing popularity/rating
# approximation instead of a real Google signal). Get one from
# https://console.cloud.google.com/apis/credentials with "Places API" and
# "Places API (New)" enabled. Never exposed to the frontend.
GOOGLE_PLACES_API_KEY=
# How many top candidates PER CATEGORY get sent to Google Places (New) for
# enrichment during itinerary generation — never the whole raw OSM
# candidate pool. Optional, defaults to 8.
GOOGLE_ENRICHMENT_LIMIT_PER_CATEGORY=8
# Max concurrent in-flight Google Places (New) enrichment requests.
# Optional, defaults to 5.
GOOGLE_ENRICHMENT_CONCURRENCY=5